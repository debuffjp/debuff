{
  "name": "@debuffjp/mcp",
  "version": "0.4.0",
  "description": "MCP server for debuff: lets AI agents inspect, build, test and play a debuff game",
  "keywords": [
    "game",
    "gamedev",
    "game-engine",
    "2d",
    "html5-game",
    "browser-game",
    "debuff",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "claude-code",
    "agents"
  ],
  "license": "MIT",
  "homepage": "https://debuff.jp",
  "bugs": "https://github.com/debuffjp/debuff/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debuffjp/debuff.git",
    "directory": "tooling/mcp"
  },
  "type": "module",
  "bin": {
    "debuff-mcp": "bin/debuff-mcp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@debuffjp/cli": "0.4.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "keiko": "0.3.1",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
