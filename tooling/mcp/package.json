{
  "name": "@debuff/mcp",
  "version": "0.0.0",
  "description": "MCP server for debuff: lets AI agents inspect, build, test and play a debuff game",
  "keywords": [
    "game",
    "mcp",
    "agents",
    "model-context-protocol",
    "debuff"
  ],
  "license": "MIT",
  "homepage": "https://github.com/debuffjp/debuff#readme",
  "bugs": "https://github.com/debuffjp/debuff/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debuffjp/debuff.git",
    "directory": "tooling/mcp"
  },
  "type": "module",
  "bin": {
    "debuff-mcp": "./bin/debuff-mcp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@debuff/cli": "0.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
