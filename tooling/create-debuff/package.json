{
  "name": "create-debuff",
  "version": "0.0.0",
  "description": "Scaffold a new debuff game: npm create debuff",
  "keywords": [
    "game",
    "create",
    "scaffold",
    "template",
    "debuff"
  ],
  "license": "MIT",
  "homepage": "https://debuff.jp",
  "bugs": "https://github.com/debuffjp/debuff/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debuffjp/debuff.git",
    "directory": "tooling/create-debuff"
  },
  "type": "module",
  "bin": {
    "create-debuff": "./bin/create-debuff.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "node scripts/copy-templates.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "giget": "^3.3.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
