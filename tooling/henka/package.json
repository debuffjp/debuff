{
  "name": "henka",
  "version": "0.1.1",
  "description": "Tests for your tests: mutation testing for Vitest projects and any test runner",
  "keywords": [
    "mutation-testing",
    "mutation",
    "testing",
    "test-quality",
    "game",
    "gamedev",
    "web-game",
    "keiko",
    "debuff"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/debuffjp",
  "homepage": "https://github.com/debuffjp/debuff/tree/main/tooling/henka#readme",
  "bugs": "https://github.com/debuffjp/debuff/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debuffjp/debuff.git",
    "directory": "tooling/henka"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "default": "./dist/source.js"
    },
    "./vite": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vite": "^8.3.7",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vite": ">=8",
    "vitest": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "bin": {
    "henka": "bin/henka.js"
  }
}
