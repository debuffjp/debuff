{
  "name": "@debuff/cli",
  "version": "0.0.0",
  "description": "The debuff CLI: dev server, builds with size reports, assets, scenarios",
  "keywords": [
    "game",
    "cli",
    "vite",
    "gamedev",
    "debuff"
  ],
  "license": "MIT",
  "homepage": "https://github.com/debuffjp/debuff#readme",
  "bugs": "https://github.com/debuffjp/debuff/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debuffjp/debuff.git",
    "directory": "tooling/cli"
  },
  "type": "module",
  "bin": {
    "debuff": "./bin/debuff.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/scenario.schema.json": "./schema/scenario.schema.json",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "schema",
    "README.md",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "cac": "^7.1.0",
    "create-debuff": "0.0.0",
    "fast-png": "^8.0.0",
    "picocolors": "^1.1.1",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
