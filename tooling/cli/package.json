{
  "name": "@debuffjp/cli",
  "version": "0.25.0",
  "description": "The debuff CLI: dev server, builds with size reports, assets, logic tests, scenarios and fuzzing",
  "keywords": [
    "game",
    "gamedev",
    "game-engine",
    "2d",
    "html5-game",
    "browser-game",
    "debuff",
    "cli",
    "vite",
    "build",
    "testing",
    "fuzzing"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/debuffjp",
  "homepage": "https://debuff.jp",
  "bugs": "https://github.com/debuffjp/debuff/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debuffjp/debuff.git",
    "directory": "tooling/cli"
  },
  "type": "module",
  "bin": {
    "debuff": "bin/debuff.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hook": {
      "types": "./dist/hook.d.ts",
      "default": "./dist/hook.js"
    },
    "./schema/scenario.schema.json": "./schema/scenario.schema.json",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "bin",
    "aseprite",
    "dist",
    "schema",
    "README.md",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "create-debuff": "0.25.0",
    "fast-png": "^8.0.0",
    "keiko": "0.7.0",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
