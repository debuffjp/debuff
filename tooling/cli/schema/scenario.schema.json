{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/debuffjp/debuff/main/tooling/cli/schema/scenario.schema.json",
  "title": "debuff scenario",
  "description": "Deterministic gameplay scenario run by `debuff scenario`. Time only advances through `wait` steps.",
  "type": "object",
  "required": ["steps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "description": "Defaults to the file name." },
    "page": { "type": "string", "description": "Path to open on the dev server.", "default": "/" },
    "reducedMotion": {
      "type": "boolean",
      "description": "Run with the browser asking for reduced motion (prefers-reduced-motion: reduce)."
    },
    "viewport": {
      "type": "array",
      "description": "Browser viewport [width, height] in CSS pixels for this scenario. Default: scenarios.viewport in debuff.config.ts, else [960, 540].",
      "prefixItems": [{ "type": "integer", "minimum": 100, "maximum": 4096 }, { "type": "integer", "minimum": 100, "maximum": 4096 }],
      "minItems": 2,
      "maxItems": 2
    },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "point": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
    "comparison": {
      "type": "object",
      "description": "All given conditions must hold.",
      "additionalProperties": false,
      "properties": {
        "eq": { "description": "Deep equality." },
        "gt": { "type": "number" },
        "gte": { "type": "number" },
        "lt": { "type": "number" },
        "lte": { "type": "number" },
        "approx": { "$ref": "#/$defs/point", "description": "[target, tolerance]" }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "required": ["wait"],
          "additionalProperties": false,
          "properties": { "wait": { "type": "integer", "minimum": 0, "description": "Advance N fixed simulation steps." } }
        },
        {
          "type": "object",
          "required": ["press"],
          "additionalProperties": false,
          "properties": {
            "press": {
              "type": "string",
              "description": "KeyboardEvent.code to hold, e.g. \"Space\", or \"PointerRight\" / \"PointerMiddle\" for the right and middle mouse buttons."
            }
          }
        },
        { "type": "object", "required": ["release"], "additionalProperties": false, "properties": { "release": { "type": "string" } } },
        {
          "type": "object",
          "required": ["tap"],
          "additionalProperties": false,
          "properties": { "tap": { "$ref": "#/$defs/point", "description": "Logical [x, y]." } }
        },
        {
          "type": "object",
          "required": ["pointerDown"],
          "additionalProperties": false,
          "properties": { "pointerDown": { "$ref": "#/$defs/point" } }
        },
        {
          "type": "object",
          "required": ["pointerMove"],
          "additionalProperties": false,
          "properties": { "pointerMove": { "$ref": "#/$defs/point" } }
        },
        { "type": "object", "required": ["pointerUp"], "additionalProperties": false, "properties": { "pointerUp": { "const": true } } },
        {
          "type": "object",
          "required": ["wheel"],
          "additionalProperties": false,
          "properties": {
            "wheel": {
              "description": "Scroll the wheel by dy CSS pixels (positive = down), or [dy, dx].",
              "oneOf": [{ "type": "number" }, { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }]
            }
          }
        },
        {
          "type": "object",
          "required": ["touchDown"],
          "additionalProperties": false,
          "properties": {
            "touchDown": {
              "description": "Start touch contact [id, x, y] (logical), or [id, x, y, \"pen\"]. The first contact also presses the primary pointer.",
              "type": "array",
              "prefixItems": [{ "type": "integer" }, { "type": "number" }, { "type": "number" }, { "const": "pen" }],
              "minItems": 3,
              "maxItems": 4
            }
          }
        },
        {
          "type": "object",
          "required": ["touchMove"],
          "additionalProperties": false,
          "properties": {
            "touchMove": {
              "description": "Move touch contact [id, x, y].",
              "type": "array",
              "prefixItems": [{ "type": "integer" }, { "type": "number" }, { "type": "number" }],
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        {
          "type": "object",
          "required": ["touchUp"],
          "additionalProperties": false,
          "properties": { "touchUp": { "type": "integer", "description": "End touch contact id." } }
        },
        {
          "type": "object",
          "required": ["pad"],
          "additionalProperties": false,
          "properties": {
            "pad": {
              "description": "Gamepad state from this step on (null = disconnected): pressed standard-mapping button indices and left stick axes.",
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["buttons", "axes"],
                  "additionalProperties": false,
                  "properties": {
                    "buttons": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
                    "axes": { "type": "array", "items": { "type": "number" }, "maxItems": 2 }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["set"],
          "additionalProperties": false,
          "properties": {
            "set": {
              "type": "object",
              "description": "Params to set, keyed \"group.key\".",
              "propertyNames": { "pattern": "^[^.]+\\..+$" },
              "additionalProperties": { "type": ["number", "boolean"] }
            }
          }
        },
        {
          "type": "object",
          "required": ["command"],
          "additionalProperties": false,
          "properties": {
            "command": { "type": "string", "description": "A command the game registered with devTools({ commands })." },
            "args": { "type": "array", "description": "Arguments passed to the command." }
          }
        },
        {
          "type": "object",
          "required": ["expect"],
          "additionalProperties": false,
          "properties": {
            "expect": {
              "type": "object",
              "description": "Dotted paths into dev state (scene, tick, time, frozen, stats.*, state.*, events.<name> = times game.emit(name) ran).",
              "additionalProperties": { "$ref": "#/$defs/comparison" }
            }
          }
        },
        {
          "type": "object",
          "required": ["until"],
          "additionalProperties": false,
          "properties": {
            "until": {
              "type": "object",
              "description": "Advance one step at a time until every condition holds (same paths as expect).",
              "additionalProperties": { "$ref": "#/$defs/comparison" }
            },
            "within": {
              "type": "integer",
              "minimum": 0,
              "default": 600,
              "description": "Fail if the conditions don't hold within this many steps."
            }
          }
        },
        {
          "type": "object",
          "required": ["flashes"],
          "additionalProperties": false,
          "properties": {
            "flashes": {
              "type": "integer",
              "minimum": 1,
              "description": "Play this many steps and fail on flashing that could trigger photosensitive seizures: more than three flashes a second over a quarter of a 10° field (approximates WCAG 2.3.1)."
            }
          }
        },
        {
          "type": "object",
          "required": ["contrast"],
          "additionalProperties": false,
          "properties": {
            "contrast": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 4,
              "maxItems": 4,
              "description": "Region [x, y, w, h] in logical units."
            },
            "min": {
              "type": "number",
              "minimum": 1,
              "maximum": 21,
              "default": 4.5,
              "description": "Minimum contrast between the region's light and dark parts (4.5 is WCAG AA for text)."
            }
          }
        },
        {
          "type": "object",
          "required": ["capture"],
          "additionalProperties": false,
          "properties": {
            "capture": {
              "type": "string",
              "pattern": "^[\\w-]+$",
              "description": "Screenshot name, compared to the per-platform baseline."
            },
            "tolerance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.002,
              "description": "Max fraction of differing pixels."
            }
          }
        }
      ]
    }
  }
}
