{
  "name": "plonkjs",
  "version": "0.3.0",
  "description": "Game music made in code: songs as tiny data, synthesized live with Web Audio. No audio files, a few kB, any engine",
  "keywords": [
    "game",
    "gamedev",
    "web-game",
    "browser-game",
    "html5-game",
    "music",
    "procedural-music",
    "chiptune",
    "synth",
    "sequencer",
    "web-audio",
    "debuff"
  ],
  "license": "MIT",
  "homepage": "https://debuff.jp/plonk/",
  "bugs": "https://github.com/debuffjp/debuff/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debuffjp/debuff.git",
    "directory": "packages/plonk"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  }
}
