{
  "name": "@debuffjp/assets",
  "version": "0.9.1",
  "description": "Manifest-driven asset loader with preload groups for debuff",
  "keywords": [
    "game",
    "gamedev",
    "game-engine",
    "2d",
    "html5-game",
    "browser-game",
    "debuff",
    "assets",
    "loader",
    "preload",
    "sprite-sheet"
  ],
  "license": "MIT",
  "homepage": "https://debuff.jp",
  "bugs": "https://github.com/debuffjp/debuff/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debuffjp/debuff.git",
    "directory": "packages/assets"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  }
}
