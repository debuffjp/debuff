{
  "name": "debuff-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tooling/*",
    "templates/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w templates/basic",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "dev": "npm run dev -w sandbox",
    "check": "npm run typecheck && npm test && npm run build && npm run test:scenarios",
    "test:scenarios": "npm test -w templates/basic"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
