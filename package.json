{
  "name": "debuff-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "build": "npm run build -w @debuff/core -w @debuff/input && npm run build -w sandbox",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "dev": "npm run dev -w sandbox",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:boundary"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": { "node": ">=20" }
}
