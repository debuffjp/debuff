{
  "name": "debuff-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tooling/*",
    "templates/*",
    "bench/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w templates/basic",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "dev": "npm run dev -w sandbox",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run lint:packages && npm run test:scenarios",
    "test:scenarios": "npm test -w templates/basic",
    "lint": "biome check .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "release": "npm run check && changeset publish",
    "test:coverage": "vitest run --coverage",
    "lint:packages": "node scripts/lint-packages.mjs",
    "test:package-manager": "node scripts/smoke-package-manager.mjs",
    "prepare": "lefthook install",
    "bench:renderer": "npm run bench -w @debuff/bench-renderer"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.3",
    "lefthook": "^2.2.2",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
