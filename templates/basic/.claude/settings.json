{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit|Bash|mcp__.*__run_scenarios)$",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/debuff.mjs claude pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/debuff.mjs claude post",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/debuff.mjs claude stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
