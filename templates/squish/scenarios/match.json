{
  "$schema": "../node_modules/@debuffjp/cli/schema/scenario.schema.json",
  "steps": [
    { "wait": 60 },
    { "command": "board", "args": [["abaacdef", "cdefabcd", "efabcdef", "abcdefab", "cdefabcd", "efabcdef", "abcdefab", "cdefabcd"]] },
    { "tap": [33, 171] },
    { "tap": [75, 171] },
    { "until": { "events.pop": { "gte": 1 } }, "within": 60 },
    { "wait": 6 },
    { "capture": "popping", "tolerance": 0.005 },
    { "until": { "state.phase": { "eq": "idle" } }, "within": 180 },
    { "expect": { "state.score": { "gte": 30 }, "state.moves": { "eq": 24 } } },
    { "flashes": 240 }
  ]
}
