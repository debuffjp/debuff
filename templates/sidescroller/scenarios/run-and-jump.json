{
  "$schema": "../node_modules/@debuffjp/cli/schema/scenario.schema.json",
  "steps": [
    { "until": { "state.player.onGround": { "eq": true } }, "within": 60 },
    { "expect": { "scene": { "eq": "play" }, "state.collected": { "eq": 0 } } },
    { "press": "ArrowRight" },
    { "until": { "state.player.x": { "gte": 160 } }, "within": 180 },
    { "press": "Space" },
    { "wait": 12 },
    { "capture": "airborne" },
    { "release": "Space" },
    { "until": { "events.spark": { "gte": 1 } }, "within": 240 },
    { "release": "ArrowRight" },
    { "expect": { "state.collected": { "gte": 1 } } },
    { "contrast": [0, 0, 72, 24] }
  ]
}
